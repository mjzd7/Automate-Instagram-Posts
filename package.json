{
  "name": "automate-instagram-posts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter web build",
    "dev": "pnpm --filter web dev",
    "seed": "pnpm --filter core exec tsx scripts/seed-db.ts",
    "setup-account": "pnpm --filter core exec tsx scripts/setup-ig-account.ts",
    "analyze-aesthetic": "pnpm --filter core exec tsx scripts/analyze-account-aesthetic.ts",
    "post-batch": "pnpm --filter core exec tsx scripts/run-post-batch.ts",
    "refresh-tokens": "pnpm --filter core exec tsx scripts/run-token-refresh.ts",
    "refresh-quotes": "pnpm --filter core exec tsx scripts/refresh-quote-pool.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "next": "^16.3.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@composio/core": "^0.15.0"
  }
}
