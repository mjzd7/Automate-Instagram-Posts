# Copy to .env.local for local dev. In CI these are injected as GitHub Actions secrets;
# in the dashboard deploy they are injected as Vercel project env vars. Never commit a
# real .env / .env.local file (already covered by .gitignore).

# --- packages/core (pipeline) required (see plan.md §7.1) ---
TOKEN_ENCRYPTION_KEY=            # openssl rand -hex 32 (exactly 64 hex chars)
GOOGLE_CLOUD_VISION_API_KEY=
UNSPLASH_ACCESS_KEY=
DISCORD_WEBHOOK_URL=
# At least one of the four embeddings keys below must be set.
JINA_API_KEY=

# --- packages/core (pipeline) optional but recommended (embeddings fallback chain) ---
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=

# --- packages/core (pipeline) optional -- quote fallback chain enhancements ---
# DummyJSON/ZenQuotes/type.fit need no key and always work; these two add
# category-filtered fallback options but the chain functions without them.
API_NINJAS_KEY=
THEY_SAID_SO_KEY=

# --- optional: Composio managed Instagram publishing ---
# Set this to use Composio managed API instead of direct Meta Graph API tokens
COMPOSIO_API_KEY=

# --- required only for the weekly refresh-token workflow (GitHub secret mirror step) ---
GH_PAT_FOR_SECRETS=

# --- packages/core optional -- Meta Graph API token lifecycle (refresh-token.yml) ---
# client.ts refreshLongLivedToken() exchanges short-lived tokens for ~60-day
# long-lived ones (fb_exchange_token); both values must come from the SAME Meta app.
META_APP_ID=
META_APP_SECRET=

# --- apps/web (dashboard) only ---
DASHBOARD_GITHUB_PAT=            # fine-grained PAT, Contents: write, used for CMS write-back
NEXTAUTH_SECRET=                 # openssl rand -base64 32
DASHBOARD_PASSWORD_HASH=         # bcrypt hash of the single dashboard user's password (username is hardcoded "admin")
GITHUB_REPO_SLUG=                # owner/repo -- Vercel doesn't auto-set GITHUB_REPOSITORY the way Actions does
GITHUB_BRANCH=                   # optional, defaults to "main"
